<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Directory.Build.props 统一 net10.0；安装程序需要 Windows 桌面组件，单独覆盖 TFM。 -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 产品版本；Build-Package.ps1 用 -p:Version=<包版本> 覆盖（命令行属性优先）。Host 当前版本输出为 0.1.0。 -->
    <Version>0.1.0</Version>
    <AssemblyName>AgentDock.Setup</AssemblyName>
    <RootNamespace>AgentDock.Setup</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <PublishReadyToRun>false</PublishReadyToRun>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AgentDock.Core\AgentDock.Core.csproj" />
  </ItemGroup>

</Project>
